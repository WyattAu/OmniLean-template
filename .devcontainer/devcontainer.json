{
  // Image flavor: no official lean4 container image exists publicly, so
  // elan bootstraps the exact pinned toolchain (see .devcontainer/elan.sh).
  // The nix flavor lives in .devcontainer/nix/.
  "name": "OmniLean",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": { "ghcr.io/devcontainers/features/git-lfs:1": {} },
  "postCreateCommand": "bash .devcontainer/elan.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "leanprover.lean4",
        "tekumara.typos-vscode",
        "EditorConfig.EditorConfig",
        "github.vscode-github-actions"
      ],
      "settings": {
        "lean4.infoview.autoOpen": true,
        "lean4.leanToolchain": "auto",
        "editor.formatOnSave": true
      }
    }
  }
}
